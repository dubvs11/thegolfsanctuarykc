<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <!-- 
        Logging Documentation:
        https://confluence.sd.apple.com/display/allOSSystemsInternals/Logging+Preferences

        For internal builds, all logging is enabled and persisted to disk so that we get actionable bugs
     -->
	<key>DEFAULT-OPTIONS</key>
	<dict>
		<key>Level</key>
		<dict>
			<key>Enable</key>
			<string>Debug</string>
			<key>Persist</key>
			<string>Debug</string>
		</dict>
		<key>TTL</key>
		<dict>
			<key>Default</key>
			<integer>14</integer>
		</dict>
		<key>Privacy-Enable-Level</key>
		<string>Private</string>
		<key>Enable-Oversize-Messages</key>
		<true/>
	</dict>
</dict>
</plist>
